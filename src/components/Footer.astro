---
const { lang, t } = Astro.props;

const defaultBrand = {
  title: 'Seedance 2.0',
  intro: 'The unified multimodal AI video generation platform. Empowering creators with director-level control and cinematic quality.',
  email: 'starwk@gmx.com',
};
const defaultColumns = {
  ai_tools: { title: 'AI Tools', links: [
    { label: 'LimaxAI', href: 'https://www.limaxai.com/' },
    { label: 'Suno', href: 'https://suno.hk/' },
    { label: 'deepseek 4', href: 'https://deepseek4.hk/' },
    { label: 'Notebooklm', href: 'https://notebooklm.vip/' },
    { label: 'Openclaw', href: 'https://openclawd.hk/' },
    { label: 'Gemini 3.0', href: 'https://gemini3.hk/' },
  ]},
  ai_video: { title: 'AI Video', links: [
    { label: 'Seedance 2.0', href: 'https://seedance22.com/' },
    { label: 'Seedance 1.5', href: 'https://seedance2.hk/' },
    { label: 'Veo 3.1', href: 'https://veo3.hk/' },
    { label: 'Veo 3', href: 'https://veo3.hk/' },
    { label: 'Sora', href: 'https://www.limaxai.com/generate/video-tools/so' },
    { label: 'Sora 2', href: 'https://www.limaxai.com/generate/video-tools/so' },
  ]},
  ai_image: { title: 'AI Image', links: [
    { label: 'Midjourney', href: 'https://www.limaxai.com/generate/image-tools/mjpro' },
    { label: 'Nano Banana 2', href: 'https://nanobananapro.hk/' },
    { label: 'Nano Banana Pro', href: 'https://nanobanana-pro.vip/' },
    { label: 'Nano Banana 3', href: 'https://nanobanana3.top/' },
  ]},
  company: { title: 'Company', links: [
    { label: 'Blog', path: 'blog' },
    { label: 'About', path: 'about' },
    { label: 'Privacy', path: 'privacy' },
    { label: 'Terms', path: 'terms' },
  ]},
};

const brand = t.footer?.brand ?? defaultBrand;
const aiTools = t.footer?.ai_tools ?? defaultColumns.ai_tools;
const aiVideo = t.footer?.ai_video ?? defaultColumns.ai_video;
const aiImage = t.footer?.ai_image ?? defaultColumns.ai_image;
const company = t.footer?.company ?? defaultColumns.company;
const copyright = t.footer?.copyright ?? '© 2026 Seedance AI. All rights reserved.';

function companyHref(path: string) {
  if (lang === 'en') return `/${path === 'blog' ? 'en/blog' : path}/`;
  return `/${lang}/${path}/`;
}
---

<footer class="bg-gray-900 text-gray-300 font-sans border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      <!-- 左侧：品牌区 -->
      <div class="lg:col-span-1 flex flex-col">
        <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-2 mb-4 w-fit group">
          <div class="w-10 h-10 bg-yellow-400 rounded-xl rotate-3 group-hover:rotate-12 transition-transform duration-300 shadow-lg"></div>
          <span class="text-xl font-black tracking-tighter text-white">Seed<span class="text-yellow-500">ance</span></span>
        </a>
        <h2 class="text-lg font-bold text-white mb-2">{brand.title}</h2>
        <p class="text-sm leading-relaxed max-w-xs mb-4">{brand.intro}</p>
        <a href={`mailto:${brand.email}`} class="text-sm text-gray-400 hover:text-yellow-400 transition-colors">{brand.email}</a>
      </div>

      <!-- 右侧：四列导航 -->
      <div class="lg:col-span-4 grid grid-cols-2 sm:grid-cols-4 gap-8 sm:gap-6">
        <div>
          <h3 class="font-bold text-lg text-white mb-4">{aiTools.title}</h3>
          <ul class="space-y-3">
            {(aiTools.links || []).map((link: { label: string; href: string }) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg text-white mb-4">{aiVideo.title}</h3>
          <ul class="space-y-3">
            {(aiVideo.links || []).map((link: { label: string; href: string }) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg text-white mb-4">{aiImage.title}</h3>
          <ul class="space-y-3">
            {(aiImage.links || []).map((link: { label: string; href: string }) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg text-white mb-4">{company.title}</h3>
          <ul class="space-y-3">
            {(company.links || []).map((link: { label: string; path: string }) => (
              <li>
                <a href={companyHref(link.path)} class="text-sm text-gray-400 hover:text-white transition-colors">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-12 pt-8">
      <p class="text-sm text-gray-500">{copyright}</p>
    </div>
  </div>
</footer>
