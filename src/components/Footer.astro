---
const { lang, t } = Astro.props;

function companyPath(path: string) {
  if (lang === 'en') return `/${path}/`;
  return `/${lang}/${path}/`;
}

// 列定义顺序（key 对应 footer 字典中的子键）
const columnKeys = ['ai_image', 'ai_video', 'ai_music', 'ai_tools', 'company'];

// 默认列配置（i18n 缺失时的兜底）
const defaultColumns: Record<string, { title: string; links: { label: string; href?: string; path?: string }[] }> = {
  ai_image: {
    title: 'AI Image',
    links: [
      { label: 'Midjourney', href: 'https://midjourney.cfd' },
      { label: 'Nano Banana Pro', href: 'https://nanobanana-pro.vip' },
      { label: 'Nano Banana 2', href: 'https://nanobananapro.hk' },
      { label: 'Nano Banana 3', href: 'https://nanobanana3.top' },
    ],
  },
  ai_video: {
    title: 'AI Video',
    links: [
      { label: 'Seedance 2.0', href: 'https://seedance22.com' },
      { label: 'Seedance 1.5', href: 'https://seedance2.hk' },
      { label: 'Veo 3', href: 'https://veo3.hk' },
      { label: 'HappyHorse1.0', href: 'https://happyhorse.fans/' },
      { label: 'HappyHorse2.0', href: 'https://happy-horse.hk/' },
    ],
  },
  ai_music: {
    title: 'AI Music',
    links: [
      { label: 'Suno', href: 'https://sunoai.me/' },
      { label: 'SunoHK', href: 'https://suno.hk/' },
      { label: 'Udio', href: 'https://udio.hk/' },
    ],
  },
  ai_tools: {
    title: 'AI Tools',
    links: [
      { label: 'LimaxAI', href: 'https://www.limaxai.com/' },
      { label: 'deepseek 4', href: 'https://deepseek4.hk' },
      { label: 'Notebooklm', href: 'https://notebooklm.vip' },
      { label: 'Openclaw', href: 'https://openclawd.hk' },
      { label: 'Gemini 3.0', href: 'https://gemini3.hk' },
      { label: 'Gemini Watermark Erase', href: 'https://geminiwatermarkerase.com/' },
    ],
  },
  company: {
    title: 'Company',
    links: [
      { label: 'Blog', path: 'blog' },
      { label: 'About', path: 'about' },
      { label: 'Privacy', path: 'privacy' },
      { label: 'Terms', path: 'terms' },
    ],
  },
};

const footer = (t.footer || {}) as Record<string, unknown>;
const brand = (footer.brand || defaultColumns.ai_image) as { title?: string; intro?: string; email?: string };
const copyright = (footer.copyright as string) ?? defaultColumns.company.title;

// 从 i18n 读取列，缺失时回退到默认配置
const resolved = columnKeys.map((key) => {
  const i18nCol = footer[key] as { title?: string; links?: { label: string; href: string; path?: string }[] } | undefined;
  const defaultCol = defaultColumns[key];
  return {
    title: i18nCol?.title ?? defaultCol.title,
    links: i18nCol?.links ?? defaultCol.links,
  };
});
---

<footer class="bg-gray-900 text-gray-300 font-sans border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-6 gap-10 lg:gap-6">
      <!-- 左侧：品牌区 -->
      <div class="md:col-span-1 flex flex-col">
        <a href={lang === 'en' ? '/' : `/${lang}/`} class="flex items-center gap-2 mb-4 w-fit group">
          <img src="/seedance22.png" srcset="/web-app-manifest-192x192.png 1x, /web-app-manifest-512x512.png 2x" width="40" height="40" alt="Seedance Logo" loading="lazy" decoding="async" class="w-10 h-10 object-contain group-hover:scale-110 transition-transform duration-300" />
          <span class="text-xl font-black tracking-tighter text-white">Seed<span class="text-yellow-500">ance</span></span>
        </a>
        <p class="text-sm leading-relaxed max-w-xs mb-4">{brand.intro}</p>
        <a href={`mailto:${brand.email}`} class="text-sm text-gray-400 hover:text-yellow-400 transition-colors">{brand.email}</a>
      </div>

      <!-- 右侧：五列导航 -->
      <div class="md:col-span-5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 lg:gap-6">
        {resolved.map((col) => (
          <div>
            <h3 class="font-bold text-base text-white mb-4">{col.title}</h3>
            <ul class="space-y-2.5">
              {col.links.map((link: { label: string; href?: string; path?: string }) => {
                const href = link.href ?? (link.path ? companyPath(link.path) : '#');
                const isExternal = href.startsWith('http');
                return (
                  <li>
                    <a
                      href={href}
                      class="text-sm text-gray-400 hover:text-white transition-colors"
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="border-t border-gray-800 mt-12 pt-8">
      <p class="text-sm text-gray-500">{copyright}</p>
    </div>
  </div>
</footer>
