---
// src/components/SEOHead.astro
import { languages } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** 可选：用于 og:image / twitter:image，建议 1200×630，绝对 URL */
  image?: string;
}

const { title, description, lang, image } = Astro.props;

const defaultOgImage = 'https://img.seedance22.com/seedance/seedance-2-cover.webp';
const ogImage = image ? (image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url.origin).toString()) : defaultOgImage;

// ---------------------------------------------------------------------------
// 修复逻辑：获取 Base URL
// 优先使用 astro.config.mjs 中的 site，如果没配置，则使用当前请求的 origin (例如 http://localhost:4321)
// ---------------------------------------------------------------------------
const siteBase = Astro.site ? Astro.site.href : Astro.url.origin;

// 语言与地区映射，用于 hreflang 与 OG locale
const localeMap: Record<string, string> = {
  en: 'en-US',
  'zh-cn': 'zh-CN',
  'zh-tw': 'zh-TW',
};

// 生成 Canonical URL（与 trailingSlash: 'always' 一致，确保与抓取 URL 一致，避免被标为「备用网页」）
let pathname = Astro.url.pathname;
if (pathname && pathname !== '/' && !pathname.endsWith('/') && !pathname.includes('.')) {
  pathname = pathname + '/';
}
const canonicalURL = new URL(pathname, siteBase);

// 生成所有语言的替代链接 (Hreflang)
const alternateLinks = Object.keys(languages).map((l) => {
  // 获取当前不带语言前缀的路径
  let currentPath = Astro.url.pathname;
  
  // 无论当前是否英文，都移除开头的语言前缀，得到裸路径
  // 例如 /ja/blog/ 或 /en/blog/ -> /blog/
  const regex = new RegExp(`^/${lang}`);
  currentPath = currentPath.replace(regex, '');
  
  // 确保路径以 / 开头（如果是根路径，currentPath可能是空字符串或/）
  if (!currentPath.startsWith('/')) {
    currentPath = '/' + currentPath;
  }

  // 构建新的链接前缀
  // 英文：首页/about/privacy/terms 在根路径（无 /en 前缀）；仅博客在 /en/blog/
  const isRoot = currentPath === '/' || currentPath === '';
  const enPrefix =
    l === 'en'
      ? isRoot
        ? ''
        : currentPath.startsWith('/blog')
          ? '/en'
          : ''
      : null;
  const prefix = enPrefix !== null ? enPrefix : `/${l}`;

  // 拼接完整路径
  const fullPath = `${prefix}${currentPath}`.replace('//', '/');
  
  const hreflang = localeMap[l] || l;
  return { lang: hreflang, href: new URL(fullPath, siteBase).toString() };
});

// Google/Bing 标准：x-default 指向英文，作为“未匹配语言时的默认版本”；百度/360 不识别 hreflang，依赖 content-language meta（见下方）
const defaultLocaleCode = localeMap['en'] || 'en-US';
const xDefaultHref = (alternateLinks.find((l) => l.lang === defaultLocaleCode) ?? alternateLinks[0] ?? { href: canonicalURL.toString() }).href;

// 百度/360 等依赖 meta content-language 识别页面语言，与 hreflang 互补
const contentLanguage = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);

const ogLocale = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-BL7ZG5E9YR"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BL7ZG5E9YR');
</script>

<meta name="baidu-site-verification" content="codeva-h01OJk7Bch" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="Seedance, Seedance 2.0, AI video, AI 视频生成, 文生视频" />
<meta http-equiv="content-language" content={contentLanguage} />
<link rel="canonical" href={canonicalURL} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta charset="UTF-8" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />

{alternateLinks.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
