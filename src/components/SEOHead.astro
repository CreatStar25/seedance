---
// src/components/SEOHead.astro
import { languages } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** 可选：用于 og:image / twitter:image，建议 1200×630，绝对 URL */
  image?: string;
}

const { title, description, lang, image } = Astro.props;

const defaultOgImage = 'https://img.seedance22.com/seedance/seedance-2-cover.webp';
const ogImage = image ? (image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url.origin).toString()) : defaultOgImage;

// ---------------------------------------------------------------------------
// Base URL
// ---------------------------------------------------------------------------
const siteBase = Astro.site ? Astro.site.href : Astro.url.origin;

// 语言与地区映射，用于 hreflang 与 OG locale
const localeMap: Record<string, string> = {
  en: 'en-US',
  'zh-cn': 'zh-CN',
  'zh-tw': 'zh-TW',
};

// ---------------------------------------------------------------------------
// Canonical URL: 自引用，清理 index.html / 双斜杠 / 确保尾斜杠
// ---------------------------------------------------------------------------
function normalizePath(p: string): string {
  // 1. 移除 /index.html 后缀（Cloudflare / 静态托管常见冗余）
  p = p.replace(/\/index\.html$/, '/');
  if (p === '/index.html') p = '/';

  // 2. 移除其他 .html 后缀（兜底，确保 canonical 不带 .html）
  p = p.replace(/\.html$/, '');

  // 3. 清理多余斜杠
  p = p.replace(/\/\/+/g, '/');

  // 4. 确保尾斜杠（与 astro.config.mjs trailingSlash: 'always' 一致）
  if (p !== '/' && !p.endsWith('/')) {
    p = p + '/';
  }

  return p;
}

const canonicalPath = normalizePath(Astro.url.pathname);
const canonicalURL = new URL(canonicalPath, siteBase);

// ---------------------------------------------------------------------------
// Hreflang 替代链接：所有语言版本 + x-default
// ---------------------------------------------------------------------------
const alternateLinks = Object.keys(languages).map((l) => {
  let currentPath = Astro.url.pathname;

  // 移除 index.html
  currentPath = currentPath.replace(/\/index\.html$/, '/');
  if (currentPath === '/index.html') currentPath = '/';

  // 移除当前语言前缀
  const regex = new RegExp(`^/${lang}`);
  currentPath = currentPath.replace(regex, '');

  // 确保以 / 开头
  if (!currentPath.startsWith('/')) currentPath = '/' + currentPath;

  // 清理多余斜杠
  currentPath = currentPath.replace(/\/\/+/g, '/');

  // 构建目标语言前缀
  const isRoot = currentPath === '/' || currentPath === '';
  const enPrefix =
    l === 'en'
      ? isRoot
        ? ''
        : currentPath.startsWith('/blog')
          ? '/en'
          : ''
      : null;
  const prefix = enPrefix !== null ? enPrefix : `/${l}`;

  let fullPath = `${prefix}${currentPath}`.replace('//', '/');

  // 统一尾斜杠
  if (fullPath !== '/' && !fullPath.endsWith('/')) {
    fullPath = fullPath + '/';
  }
  // 再次清理多余斜杠
  fullPath = fullPath.replace(/\/\/+/g, '/');

  const hreflang = localeMap[l] || l;
  return { lang: hreflang, href: new URL(fullPath, siteBase).toString() };
});

// x-default 指向英文
const defaultLocaleCode = localeMap['en'] || 'en-US';
const xDefaultHref = (alternateLinks.find((l) => l.lang === defaultLocaleCode) ?? alternateLinks[0] ?? { href: canonicalURL.toString() }).href;

// content-language meta（百度/360 依赖此 meta 识别语言）
const contentLanguage = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);
const keywords = (t.seo as Record<string, unknown> | undefined)?.keywords as string | undefined;

// content-language meta（百度/360 依赖此 meta 识别语言）
const contentLanguage = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);
const ogLocale = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);

// 百度统计：仅在中文页面加载
const loadBaiduAnalytics = lang === 'zh-cn' || lang === 'zh-tw';
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-BL7ZG5E9YR"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BL7ZG5E9YR');
</script>

{loadBaiduAnalytics && (
  <>
    <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?109e6d1657ba4ee7fdd50260a3950e3e";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  </>
)}

<meta name="baidu-site-verification" content="codeva-h01OJk7Bch" />

<!-- Favicon & App Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#000000" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords ?? "Seedance, Seedance 2.0, AI video, AI video generator, text to video, image to video, multimodal AI"} />
<meta http-equiv="content-language" content={contentLanguage} />
<link rel="canonical" href={canonicalURL} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta charset="UTF-8" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />

{alternateLinks.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
