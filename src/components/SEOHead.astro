---
// src/components/SEOHead.astro
import { languages } from '../i18n/locales';
import { stripTrailingLangSegments } from '../i18n/pathNormalize';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** 可选：用于 og:image / twitter:image，建议 1200×630，绝对 URL */
  image?: string;
  /** 可选：keywords meta 标签内容，支持多语言 */
  keywords?: string;
  /** 可选：robots meta 标签内容，如 "noindex, nofollow" */
  robots?: string;
  /** 可选：文章结构化数据，用于博客/指南详情页 */
  article?: {
    datePublished?: string;
    dateModified?: string;
    author?: string;
  };
  /** 可选：FAQ 列表，用于 FAQPage 结构化数据 */
  faqs?: Array<{
    question: string;
    answer: string;
  }>;
  /** 可选：Schema 类型，默认为 website + organization */
  schemaType?: 'website' | 'article' | 'product' | 'faq';
  /** 若提供，仅对这些语种输出 hreflang（文章/教程等避免指向未构建 URL） */
  hreflangLocales?: string[];
}

const { 
  title, 
  description, 
  lang, 
  image, 
  keywords, 
  robots,
  article,
  faqs,
  schemaType = 'website',
  hreflangLocales,
} = Astro.props;

const ogType = schemaType === 'article' ? 'article' : 'website';
const articlePublishedOg =
  schemaType === 'article' && article?.datePublished
    ? `${article.datePublished}T00:00:00.000Z`
    : null;
const articleModifiedOg =
  schemaType === 'article' && article?.dateModified
    ? `${article.dateModified}T00:00:00.000Z`
    : articlePublishedOg;

const defaultOgImage = 'https://img.seedance22.com/aiweb/seedance2-260812-1.png';
const ogImage = image ? (image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url.origin).toString()) : defaultOgImage;

// 默认 keywords（如果未提供）
const defaultKeywords = "Seedance, Seedance 2.5, AI video, AI video generator, text to video, image to video, multimodal AI, video AI model, AI video creation, ByteDance AI";

// ---------------------------------------------------------------------------
// Base URL
// ---------------------------------------------------------------------------
const siteBase = Astro.site ? Astro.site.href : Astro.url.origin;
// 确保 siteBase 以斜杠结尾，避免 URL 拼接错误
const siteBaseNormalized = siteBase.endsWith('/') ? siteBase : `${siteBase}/`;
const organizationId = `${siteBaseNormalized}#organization`;
const websiteId = `${siteBaseNormalized}#website`;
const organizationLogoUrl = new URL('web-app-manifest-512x512.png', siteBaseNormalized).toString();

// 语言与地区映射，用于 hreflang 与 OG locale
// 完全覆盖 astro.config.mjs 中 sitemap 配置的全部 25 种语言
// 确保 hreflang 代码与 sitemap 完全一致，避免 Google 警告
const localeMap: Record<string, string> = {
  en: 'en',
  'zh-cn': 'zh-CN',
  'zh-tw': 'zh-TW',
  es: 'es',
  ar: 'ar',
  pt: 'pt',
  id: 'id',
  ms: 'ms',
  fr: 'fr',
  ru: 'ru',
  hi: 'hi',
  ja: 'ja',
  de: 'de',
  ko: 'ko',
  tr: 'tr',
  vi: 'vi',
  th: 'th',
  it: 'it',
  fa: 'fa',
  nl: 'nl',
  pl: 'pl',
  sv: 'sv',
  uk: 'uk',
  ro: 'ro',
};

// ---------------------------------------------------------------------------
// Canonical URL: 自引用，清理 index.html / .html / 双斜杠 / 确保尾斜杠
// ---------------------------------------------------------------------------
function normalizePath(p: string): string {
  // 1. 处理根 index.html（如 /index.html -> /）
  if (p === '/index.html') return '/';

  // 2. 移除末尾的 /index.html（如 /blog/index.html -> /blog/）
  p = p.replace(/\/index\.html$/, '/');

  // 3. 移除所有 .html 后缀（包括中间的 index.html 和任意 .html）
  // 确保 canonical 永远不带 .html 后缀
  p = p.replace(/\/index\.html/g, '/');
  p = p.replace(/\.html$/, '');
  p = p.replace(/\.html\//g, '/');

  // 4. 清理连续双斜杠为单斜杠
  p = p.replace(/\/\/+/g, '/');

  // 5. 确保非根路径带尾斜杠（与 astro.config.mjs trailingSlash: 'always' 一致）
  if (p !== '/' && !p.endsWith('/')) {
    p = p + '/';
  }

  return p;
}

const pathForSeo = stripTrailingLangSegments(Astro.url.pathname);
const canonicalPath = normalizePath(pathForSeo);
// 使用规范化后的 siteBase 确保 URL 拼接正确
const canonicalURL = new URL(canonicalPath, siteBase);

// ---------------------------------------------------------------------------
// Hreflang 替代链接：所有语言版本 + x-default
// ---------------------------------------------------------------------------

// 当前页面去掉语言前缀后的 "裸路径"，用于拼接各语言 URL
function stripLangPrefix(path: string, currentLang: string): string {
  // 彻底移除所有 index.html 引用
  path = path.replace(/\/index\.html$/, '/');
  path = path.replace(/\/index\.html\//g, '/');
  if (path === '/index.html') path = '/';

  // 移除语言前缀（如 /zh-tw/blog/xxx -> /blog/xxx，或 / -> /）
  // 注意：正则必须匹配带斜杠的前缀，避免 /en 误匹配 /english
  path = path.replace(new RegExp(`^/${currentLang}(?=/|$)`), '');

  // 保证以 / 开头
  if (!path.startsWith('/')) path = '/' + path;

  // 清理多余斜杠
  path = path.replace(/\/\/+/g, '/');

  // 再次确保没有 .html 后缀
  path = path.replace(/\.html$/, '');
  path = path.replace(/\.html\//g, '/');

  return path;
}

// 为目标语言构建完整路径
function buildLangPath(nakedPath: string, targetLang: string): string {
  const isRoot = nakedPath === '/' || nakedPath === '';
  let prefix: string;

  if (targetLang === 'en') {
    // 英文所有页面都在根路径，不使用 /en 前缀
    prefix = '';
  } else {
    // 其他语言统一加 /{lang} 前缀
    prefix = isRoot ? `/${targetLang}` : `/${targetLang}`;
  }

  let fullPath = `${prefix}${nakedPath}`;

  // 修复 /en + /xxx 变成 /en/xxx（replace 第一个 // 为 /）
  fullPath = fullPath.replace(/^\/{2,}/, '/');

  // 确保尾斜杠
  if (fullPath !== '/' && !fullPath.endsWith('/')) {
    fullPath = fullPath + '/';
  }

  // 最终清理连续双斜杠
  fullPath = fullPath.replace(/\/\/+/g, '/');

  return fullPath;
}

const nakedPath = stripLangPrefix(pathForSeo, lang);

let langsForHreflang = Object.keys(languages);
if (hreflangLocales && hreflangLocales.length > 0) {
  const filtered = [...new Set(hreflangLocales)].filter((l) => l in languages);
  if (filtered.length > 0) langsForHreflang = filtered;
}

const alternateLinks = langsForHreflang.map((l) => {
  const fullPath = buildLangPath(nakedPath, l);
  const hreflang = localeMap[l] || l;
  return { lang: hreflang, href: new URL(fullPath, siteBase).toString() };
});

/** Schema.org 要求的 @type 书写（PascalCase），避免富结果校验失败 */
function schemaJsonLdType(
  type: 'website' | 'organization' | 'product' | 'article' | 'faq' | 'softwareapplication'
): string {
  const map: Record<string, string> = {
    website: 'WebSite',
    organization: 'Organization',
    product: 'Product',
    article: 'Article',
    faq: 'FAQPage',
    softwareapplication: 'SoftwareApplication',
  };
  return map[type] ?? type;
}

// JSON-LD 结构化数据生成函数
function generateStructuredData(type: 'website' | 'organization' | 'product' | 'article' | 'faq' | 'softwareapplication', data?: any) {
  const baseData = {
    "@context": "https://schema.org",
    "@type": schemaJsonLdType(type),
  };

  switch (type) {
    case 'website':
      return {
        ...baseData,
        "@id": websiteId,
        // WebSite 表示整站，url 必须为站点根，勿用当前页 canonical（否则与 Article 冲突、易触发 GSC 规范网址不一致）
        "url": siteBaseNormalized,
        "name": "Seedance 2.5",
        "description": "Seedance AI video generation guides, tutorials, and product information.",
        "publisher": { "@id": organizationId },
      };
    
    case 'organization':
      return {
        ...baseData,
        "@id": organizationId,
        "name": "Seedance AI",
        "url": siteBaseNormalized,
        "logo": {
          "@type": "ImageObject",
          "@id": `${organizationId}/logo`,
          "url": organizationLogoUrl,
          "contentUrl": organizationLogoUrl,
          "width": 512,
          "height": 512
        }
      };
    
    case 'product':
      return {
        ...baseData,
        "name": title,
        "description": description,
        "image": ogImage,
        "brand": {
          "@type": "Brand",
          "name": "Seedance"
        }
      };
    
    case 'article':
      return {
        ...baseData,
        "@id": `${canonicalURL.toString()}#article`,
        "url": canonicalURL.toString(),
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": `${canonicalURL.toString()}#webpage`,
        },
        "headline": title,
        "description": description,
        "image": ogImage,
        "datePublished": data?.datePublished || new Date().toISOString().split('T')[0],
        "dateModified": data?.dateModified || new Date().toISOString().split('T')[0],
        "author": {
          "@type": "Person",
          "name": data?.author || "Seedance Team"
        },
        "publisher": { "@id": organizationId },
        "isPartOf": { "@id": websiteId }
      };
    
    case 'faq':
      return {
        ...baseData,
        "mainEntity": (faqs || []).map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      };
    
    case 'softwareapplication':
      return {
        ...baseData,
        "name": "Seedance 2.5",
        "description": description,
        "image": ogImage,
        "url": canonicalURL.toString(),
        "author": {
          "@id": organizationId
        },
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "Any",
        "featureList": "Text to video, image to video, multimodal AI video generation, cinematic quality, director-level control, native audio sync",
        "brand": {
          "@type": "Brand",
          "name": "Seedance"
        }
      };
    
    default:
      return baseData;
  }
}

// 生成结构化数据集合
const structuredDataList = [];

// 总是添加 Website 和 Organization
structuredDataList.push(generateStructuredData('website'));
structuredDataList.push(generateStructuredData('organization'));

// 如果是文章页面，添加 Article
if (schemaType === 'article' && article) {
  structuredDataList.push(generateStructuredData('article', article));
}

// 如果是FAQ页面，添加 FAQPage
if (schemaType === 'faq' && faqs && faqs.length > 0) {
  structuredDataList.push(generateStructuredData('faq', { faqs }));
}

// 如果是首页，添加 SoftwareApplication 结构化数据
if (schemaType === 'faq') {
  structuredDataList.push(generateStructuredData('softwareapplication'));
}

// x-default：优先英文对应 URL；无英文译文时退回当前 canonical
const defaultLocaleCode = localeMap['en'] || 'en';
const xDefaultHref =
  alternateLinks.find((l) => l.lang === defaultLocaleCode)?.href ?? canonicalURL.toString();

// content-language meta（百度/360 依赖此 meta 识别语言）
const contentLanguage = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);
const ogLocale = localeMap[lang] || (lang === 'en' ? 'en-US' : lang);

// 百度统计：仅在中文页面加载
const loadBaiduAnalytics = lang === 'zh-cn' || lang === 'zh-tw';
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-BL7ZG5E9YR"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-BL7ZG5E9YR');
</script>

{loadBaiduAnalytics && (
  <>
    <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?f25c62a8a815ca3c5d6e6bb9b4028106";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  </>
)}

<meta name="baidu-site-verification" content="codeva-h01OJk7Bch" />
<!-- Google Search Console 验证（如需使用，请替换为实际验证码） -->
<!-- <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" /> -->
<!-- Yandex 验证（如需针对俄语市场优化） -->
<!-- <meta name="yandex-verification" content="YOUR_YANDEX_VERIFICATION" /> -->
<!-- Naver 验证（如需针对韩语市场优化） -->
<!-- <meta name="naver-site-verification" content="YOUR_NAVER_VERIFICATION" /> -->

<!-- Favicon & App Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#000000" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords || defaultKeywords} />
<meta name="robots" content={robots || "index, follow"} />
<link rel="canonical" href={canonicalURL} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta charset="UTF-8" />
<!-- Removed: http-equiv="content-language" (deprecated in HTML5) -->
<!-- Removed: generator (avoids Astro version information disclosure) -->

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{articlePublishedOg && <meta property="article:published_time" content={articlePublishedOg} />}
{articleModifiedOg && <meta property="article:modified_time" content={articleModifiedOg} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="Seedance 2.5" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

{alternateLinks.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

{/* JSON-LD：勿用 is:inline，否则子表达式不会被编译，页面会出现字面量 "{JSON.stringify...}" */}
{structuredDataList.map((data) => (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
  />
))}
