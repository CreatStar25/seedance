---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SEOHead from '../../components/SEOHead.astro';
import PersistLang from '../../components/PersistLang.astro';
import { loadTranslations } from '../../i18n/loadTranslations';
import { localesForContentSlug } from '../../i18n/hreflangLocales';
import GuideArticleShell from '../../components/guide/GuideArticleShell.astro';
import { contentRobots } from '../../utils/contentQuality';

function getPostDate(data: { pubDate?: Date; date?: Date }) {
  return data.pubDate ?? data.date ?? new Date(0);
}

export async function getStaticPaths() {
  const entries = await getCollection('guide');
  return entries
    .filter((entry) => entry.id.startsWith('en/'))
    .map((entry) => {
      const slug = entry.id.split('/').slice(1).join('/').replace(/\.md$/, '');
      return {
        params: { slug },
        props: { entry },
      };
    });
}

const { entry } = Astro.props;
const lang = 'en';
const { slug: currentSlug } = Astro.params;
const allGuides = await getCollection('guide');
const hreflangLocales = localesForContentSlug(allGuides, currentSlug!);
const { Content } = await entry.render();

const coverImage = entry.data.image ?? entry.data.heroImage;
const t = await loadTranslations(lang);

const rawDate = entry.data.pubDate ?? entry.data.date ?? new Date(0);
const articleAuthor = entry.data.author ?? 'Seedance Team';
const formattedDate = new Date(rawDate).toLocaleDateString(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const siblings = allGuides
  .filter((e) => e.id.startsWith('en/'))
  .sort((a, b) => getPostDate(b.data).valueOf() - getPostDate(a.data).valueOf())
  .map((e) => {
    const s = e.id.split('/').slice(1).join('/').replace(/\.md$/, '');
    return { slug: s, title: e.data.title };
  });

const guideIndexHref = '/guide/';
const guideArticleBase = '/guide/';
const appUrl = 'https://app.seedance22.com/generate/video-tools/seedance2.0';
---

<html lang={lang} data-lang={lang}>
  <head>
    <SEOHead
      title={`${entry.data.title} - Seedance`}
      description={entry.data.description}
      keywords={t.seo?.keywords}
      lang={lang}
      robots={contentRobots('guide', entry.id)}
      image={coverImage}
      schemaType="article"
      hreflangLocales={hreflangLocales}
      article={{
        datePublished: new Date(rawDate).toISOString().split('T')[0],
        dateModified: entry.data.lastModified
          ? new Date(entry.data.lastModified).toISOString().split('T')[0]
          : new Date(rawDate).toISOString().split('T')[0],
        author: articleAuthor,
      }}
    />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased flex flex-col min-h-screen">
    <PersistLang lang={lang} />
    <Header lang={lang} t={t} />

    <main class="flex-grow">
      <GuideArticleShell
        lang={lang}
        t={t}
        title={entry.data.title}
        description={entry.data.description}
        formattedDate={formattedDate}
        author={articleAuthor}
        guideIndexHref={guideIndexHref}
        guideArticleBase={guideArticleBase}
        siblings={siblings}
        currentSlug={currentSlug!}
        appUrl={appUrl}
      >
        <Content />
      </GuideArticleShell>
    </main>

    <Footer lang={lang} t={t} />
    <script is:inline>
      if (typeof window !== 'undefined') {
        window.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('video').forEach((video) => {
            if (video.hasAttribute('poster')) video.removeAttribute('poster');
            if (!video.hasAttribute('preload')) video.setAttribute('preload', 'metadata');
          });
        });
      }
    </script>
  </body>
</html>
