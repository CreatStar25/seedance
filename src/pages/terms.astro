---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'en';
const t = (await import('../i18n/en.json')).default;
---

<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead title={t.terms?.title ?? 'Terms of Service'} description={t.terms?.description ?? ''} lang={lang} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <Header lang={lang} t={t} />
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
      <h1 class="text-3xl font-black text-gray-900 mb-6">{t.terms?.heading ?? 'Terms of Service'}</h1>
      <p class="text-gray-600 leading-relaxed whitespace-pre-line">{t.terms?.content ?? ''}</p>
    </main>
    <Footer lang={lang} t={t} />
  </body>
</html>
