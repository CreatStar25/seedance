---
import { languages } from '../i18n/locales';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PersistLang from '../components/PersistLang.astro';

const { lang = 'en' } = Astro.params;
let translations;
try { translations = await import(`../i18n/${lang}.json`); }
catch (e) { translations = await import(`../i18n/en.json`); }
const t = translations.default || translations;
---

<html lang={lang} dir={['ar','fa'].includes(lang) ? 'rtl' : 'ltr'} class="scroll-smooth" data-lang={lang}>
  <head>
    <script is:inline>
      (function () {
        var path = typeof location !== 'undefined' ? (location.pathname || '/') : '/';
        var isRoot = path === '/' || path === '' || path === '/index.html';
        if (!isRoot) return;
        var KEY = 'seedance_lang';
        var SUPPORTED = ['en','zh-cn','zh-tw','es','ar','pt','id','ms','fr','ru','hi','ja','de','ko','tr','vi','th','it','fa','nl','pl','sv','uk','ro'];
        function mapTag(tag) {
          if (!tag) return null;
          var s = tag.toLowerCase().trim();
          if (s.indexOf('zh-cn') === 0 || s.indexOf('zh-hans') === 0) return 'zh-cn';
          if (s.indexOf('zh-tw') === 0 || s.indexOf('zh-hk') === 0 || s.indexOf('zh-hant') === 0) return 'zh-tw';
          if (s === 'zh') return 'zh-cn';
          var code = s.split('-')[0];
          if (SUPPORTED.indexOf(code) !== -1) return code;
          if (SUPPORTED.indexOf(s) !== -1) return s;
          return null;
        }
        try {
          var saved = localStorage.getItem(KEY);
          if (saved && saved !== 'en' && SUPPORTED.indexOf(saved) !== -1) {
            location.replace('/' + saved + '/');
            return;
          }
          if (!saved) {
            var preferred = null;
            if (typeof navigator !== 'undefined' && navigator.languages && navigator.languages.length) {
              for (var i = 0; i < navigator.languages.length; i++) {
                preferred = mapTag(navigator.languages[i]);
                if (preferred) break;
              }
            }
            if (!preferred && typeof navigator !== 'undefined' && navigator.language) preferred = mapTag(navigator.language);
            if (preferred && preferred !== 'en') {
              localStorage.setItem(KEY, preferred);
              location.replace('/' + preferred + '/');
              return;
            }
            localStorage.setItem(KEY, 'en');
          }
        } catch (e) {}
      })();
    </script>
    <SEOHead title={t.seo.title} description={t.seo.description} lang={lang} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased selection:bg-yellow-200 selection:text-black">
    <PersistLang lang={lang} />
    <Header lang={lang} t={t} />

    <main>
      <section class="relative pt-24 pb-32 overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-yellow-100/40 via-white to-white"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-yellow-200/20 blur-[100px] rounded-full -z-10"></div>

        <div class="max-w-7xl mx-auto px-6 text-center">
          <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-yellow-50 border border-yellow-200 text-yellow-700 text-sm font-bold mb-8 animate-fade-in-up">
            {t.hero?.badge || "🚀 New Release: Seedance 2.0"}
          </div>
          
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight text-gray-900 mb-8 leading-[1.1]">
            {t.hero.title} <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-orange-600 drop-shadow-sm">
              {t.hero.highlight}
            </span>
          </h1>
          
          <p class="max-w-2xl mx-auto text-xl md:text-2xl text-gray-600 mb-12 leading-relaxed">
            {t.hero.subtitle}
          </p>
          
          <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
            <a href="https://app.seedance22.com/generate/video-tools/seedance2.0" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-10 py-4 bg-black text-white rounded-full font-bold text-lg hover:bg-gray-800 hover:scale-105 transition-all shadow-xl hover:shadow-yellow-500/20">
              {t.hero.button}
            </a>
            <p class="text-sm font-semibold text-gray-500 flex items-center gap-2">
              <span class="flex h-3 w-3 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
              </span>
              {t.hero.users}
            </p>
          </div>

          <div class="mt-20 p-2 bg-gray-900/5 rounded-3xl backdrop-blur-sm max-w-5xl mx-auto">
             <div class="rounded-2xl border-4 border-white shadow-2xl overflow-hidden aspect-[16/9] bg-gray-900 relative group">
                <video
                  src="https://img.seedance22.com/seedance/seedance-2-cover.webp"
                  autoplay
                  loop
                  muted
                  playsinline
                  class="absolute inset-0 w-full h-full object-cover"
                >
                  <img src="https://img.seedance22.com/seedance/seedance-2-cover.webp" alt="Seedance 2.0 Preview" class="w-full h-full object-cover" />
                </video>
             </div>
          </div>
        </div>
      </section>

      <section class="border-y border-gray-100 bg-gray-50/50 py-16">
         <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-200">
            {t.stats && t.stats.map((stat: any) => (
              <div class="pt-4 md:pt-0">
                <div class="text-4xl md:text-5xl font-black text-gray-900 mb-2">{stat.value}</div>
                <div class="text-gray-500 font-bold uppercase tracking-wider text-sm">{stat.label}</div>
              </div>
            ))}
         </div>
      </section>

      <!-- Text to Video Section -->
      <section id="text-to-video" class="py-24 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col md:flex-row items-center gap-16">
            <div class="md:w-1/2">
              <div class="inline-flex items-center px-3 py-1 rounded-full bg-purple-100 text-purple-700 text-xs font-bold mb-6 uppercase tracking-wider">
                {t.product_features?.text_to_video?.badge || "Flagship Model"}
              </div>
              <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                {t.product_features?.text_to_video?.title || "Text to Video AI"}
              </h2>
              <p class="text-xl text-gray-500 mb-8 leading-relaxed">
                {t.product_features?.text_to_video?.desc || "Describe scenes, characters and camera moves in natural language."}
              </p>
              <ul class="space-y-4 mb-8">
                <li class="flex items-center gap-3 text-gray-700 font-medium">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  {t.product_features?.text_to_video?.bullets?.[0] || "Cinematic Camera Control"}
                </li>
                <li class="flex items-center gap-3 text-gray-700 font-medium">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  {t.product_features?.text_to_video?.bullets?.[1] || "Multi-Shot Consistency"}
                </li>
                <li class="flex items-center gap-3 text-gray-700 font-medium">
                  <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  {t.product_features?.text_to_video?.bullets?.[2] || "Physics-Based Motion"}
                </li>
              </ul>
              <a href="https://app.seedance22.com/generate/video-tools/seedance2.0" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-3 bg-black text-white rounded-full font-bold hover:bg-gray-800 transition-all group">
                {t.product_features?.text_to_video?.cta || "Create Video"}
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
            <div class="md:w-1/2 relative">
              <div class="absolute inset-0 bg-gradient-to-tr from-purple-200 to-pink-200 rounded-3xl blur-2xl opacity-50 -z-10 transform rotate-3"></div>
              <div class="bg-gray-900 rounded-3xl overflow-hidden shadow-2xl aspect-video relative group border border-gray-800">
                <video
                  src="https://img.seedance22.com/seedance/seedance-2-demo1.webp"
                  autoplay
                  loop
                  muted
                  playsinline
                  class="absolute inset-0 w-full h-full object-cover"
                >
                  <img src="https://img.seedance22.com/seedance/seedance-2-demo1.webp" alt="Seedance 2.0 Demo" class="w-full h-full object-cover" />
                </video>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Image to Video Section -->
      <section id="image-to-video" class="py-24 bg-gray-50 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col md:flex-row-reverse items-center gap-16">
            <div class="md:w-1/2">
              <div class="inline-flex items-center px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold mb-6 uppercase tracking-wider">
                {t.product_features?.image_to_video?.badge || "Static to Motion"}
              </div>
              <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                {t.product_features?.image_to_video?.title || "Image to Video AI"}
              </h2>
              <p class="text-xl text-gray-500 mb-8 leading-relaxed">
                {t.product_features?.image_to_video?.desc || "Animate your photos with incredible realism."}
              </p>
              <ul class="space-y-4 mb-8">
                 <li class="flex items-center gap-3 text-gray-700 font-medium">
                  <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  {t.product_features?.image_to_video?.bullets?.[0] || "Preserve Subject Identity"}
                </li>
                <li class="flex items-center gap-3 text-gray-700 font-medium">
                  <svg class="w-5 h-5 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  {t.product_features?.image_to_video?.bullets?.[1] || "Control Motion Strength"}
                </li>
              </ul>
              <a href="#" class="inline-flex items-center justify-center px-8 py-3 bg-white text-black border border-gray-200 rounded-full font-bold hover:bg-gray-100 transition-all group shadow-sm">
                {t.product_features?.image_to_video?.cta || "Animate Image"}
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
            <div class="md:w-1/2 relative">
               <div class="grid grid-cols-2 gap-4">
                  <div class="relative group rounded-2xl overflow-hidden shadow-lg hover:-translate-y-1 transition-transform duration-300">
                    <div class="aspect-[4/5] bg-gray-200 relative">
                       <img src="https://img.seedance22.com/seedance/seedance-2-demo2.webp" alt="Seedance demo image" class="absolute inset-0 w-full h-full object-cover object-[50%_30%]" />
                    </div>
                  </div>
                  <div class="relative group rounded-2xl overflow-hidden shadow-lg hover:-translate-y-1 transition-transform duration-300 mt-8">
                    <div class="aspect-[4/5] bg-black relative">
                       <video
                         src="https://img.seedance22.com/seedance/seedance-2-demo3.webp"
                         autoplay
                         loop
                         muted
                         playsinline
                         class="absolute inset-0 w-full h-full object-cover object-[50%_30%]"
                       >
                         <img src="https://img.seedance22.com/seedance/seedance-2-demo3.webp" alt="Seedance demo video" class="absolute inset-0 w-full h-full object-cover object-[50%_30%]" />
                       </video>
                    </div>
                  </div>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- AI Tools Section -->
      <section id="ai-tools" class="py-24 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col md:flex-row items-center gap-16">
            <div class="md:w-1/2">
              <div class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold mb-6 uppercase tracking-wider">
                {t.product_features?.ai_tools?.badge || "Creative Suite"}
              </div>
              <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                {t.product_features?.ai_tools?.title || "AI Video Effects"}
              </h2>
              <p class="text-xl text-gray-500 mb-8 leading-relaxed">
                {t.product_features?.ai_tools?.desc || "Instant professional effects with one click."}
              </p>
              <div class="grid grid-cols-2 gap-4 mb-8">
                <div class="p-4 bg-gray-50 rounded-2xl border border-gray-100 hover:border-yellow-300 transition-colors">
                   <h4 class="font-bold text-gray-900 mb-1">{t.product_features?.ai_tools?.cards?.[0]?.title || "Face Swap"}</h4>
                   <p class="text-sm text-gray-500">{t.product_features?.ai_tools?.cards?.[0]?.desc || "Perfect for memes & marketing"}</p>
                </div>
                <div class="p-4 bg-gray-50 rounded-2xl border border-gray-100 hover:border-yellow-300 transition-colors">
                   <h4 class="font-bold text-gray-900 mb-1">{t.product_features?.ai_tools?.cards?.[1]?.title || "Style Transfer"}</h4>
                   <p class="text-sm text-gray-500">{t.product_features?.ai_tools?.cards?.[1]?.desc || "Anime, Clay, 3D Render..."}</p>
                </div>
              </div>
              <a href="#" class="inline-flex items-center justify-center px-8 py-3 bg-black text-white rounded-full font-bold hover:bg-gray-800 transition-all group">
                {t.product_features?.ai_tools?.cta || "Explore Tools"}
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>
            <div class="md:w-1/2">
               <div class="bg-gray-100 rounded-3xl p-8 border border-gray-200">
                  <div class="grid grid-cols-2 gap-4">
                     <div class="aspect-square bg-white rounded-xl shadow-sm p-4 flex flex-col items-center justify-center text-center">
                        <div class="w-12 h-12 bg-yellow-100 rounded-full mb-3 flex items-center justify-center text-yellow-600">✨</div>
                        <span class="font-bold text-sm">{t.product_features?.ai_tools?.grid?.[0] || "Magic Edit"}</span>
                     </div>
                     <div class="aspect-square bg-white rounded-xl shadow-sm p-4 flex flex-col items-center justify-center text-center">
                        <div class="w-12 h-12 bg-blue-100 rounded-full mb-3 flex items-center justify-center text-blue-600">🎭</div>
                        <span class="font-bold text-sm">{t.product_features?.ai_tools?.grid?.[1] || "Face Swap"}</span>
                     </div>
                     <div class="aspect-square bg-white rounded-xl shadow-sm p-4 flex flex-col items-center justify-center text-center">
                        <div class="w-12 h-12 bg-purple-100 rounded-full mb-3 flex items-center justify-center text-purple-600">🎨</div>
                        <span class="font-bold text-sm">{t.product_features?.ai_tools?.grid?.[2] || "Restyle"}</span>
                     </div>
                     <div class="aspect-square bg-white rounded-xl shadow-sm p-4 flex flex-col items-center justify-center text-center">
                        <div class="w-12 h-12 bg-green-100 rounded-full mb-3 flex items-center justify-center text-green-600">🔍</div>
                        <span class="font-bold text-sm">{t.product_features?.ai_tools?.grid?.[3] || "Upscale"}</span>
                     </div>
                  </div>
               </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-32 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-20 max-w-3xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6">{t.features.title}</h2>
            <p class="text-xl text-gray-500">{t.features.subtitle}</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {t.features.list.map((feature: any) => (
              <div class="group relative p-8 rounded-3xl bg-gray-50 border border-gray-100 hover:border-transparent hover:shadow-2xl hover:shadow-gray-200/50 transition-all duration-500 hover:-translate-y-2">
                <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${feature.iconColor} flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500 shadow-lg group-hover:shadow-xl`}>
                  <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={feature.iconSvg} />
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">{feature.title}</h3>
                <p class="text-gray-500 leading-relaxed text-sm mb-5">{feature.desc}</p>
                <div class="flex flex-wrap gap-2">
                  {feature.tags?.map((tag: string) => (
                    <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${feature.tagBg} ${feature.tagText} hover:scale-105 transition-transform cursor-default`}>
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-32 bg-black text-white rounded-t-[3rem] -mt-10 relative z-10">
        <div class="max-w-5xl mx-auto px-6">
          <h2 class="text-4xl md:text-5xl font-black text-center mb-16">{t.comparison.title}</h2>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr>
                  <th class="p-6 text-gray-400 font-medium uppercase tracking-wider border-b border-gray-800 w-1/3">{t.comparison.headers[0]}</th>
                  <th class="p-6 text-yellow-400 font-bold text-xl border-b border-gray-800 w-1/3">{t.comparison.headers[1]}</th>
                  <th class="p-6 text-gray-500 font-bold border-b border-gray-800 w-1/3">{t.comparison.headers[2]}</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-800">
                {t.comparison.rows.map((row: any) => (
                  <tr class="group hover:bg-white/5 transition-colors">
                    <td class="p-6 font-bold text-white">{row.label}</td>
                    <td class="p-6 font-medium text-white" set:html={row.us}></td>
                    <td class="p-6 text-gray-500" set:html={row.others}></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="py-32 bg-white">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-4xl font-black text-center mb-20">{t.showcase.title}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {[
              'https://img.seedance22.com/aiweb/seedance2-0-demo-1.mp4',
              'https://img.seedance22.com/aiweb/seedance2-0-demo-2.mp4',
              'https://img.seedance22.com/aiweb/seedance2-0-demo-3.mp4',
              'https://img.seedance22.com/aiweb/seedance2-0-demo-4.mp4',
            ].map((videoSrc, i) => (
              <div data-video-card class="group relative rounded-2xl overflow-hidden aspect-[3/4] bg-gray-900">
                <video
                  src={videoSrc}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  class="absolute inset-0 w-full h-full object-cover"
                ></video>
                <button
                  class="play-btn absolute inset-0 flex items-center justify-center cursor-pointer z-10"
                  onclick={`this.closest('[data-video-card]').querySelector('video').play().then(()=>this.classList.add('hidden')).catch(()=>{})`}
                >
                  <div class="w-14 h-14 rounded-full bg-white/25 backdrop-blur-sm flex items-center justify-center transition-all duration-300 hover:bg-white/35 hover:scale-110">
                    <svg class="w-7 h-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-24 bg-yellow-50">
        <div class="max-w-7xl mx-auto px-6">
          <h2 class="text-4xl font-black text-center mb-16">{t.testimonials.title}</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {t.testimonials.list.map((item: any, i: number) => (
              <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100 relative">
                <svg class="w-10 h-10 text-yellow-300 absolute top-6 left-6 -z-0" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.896 14.389 16.03 15.133 15.401C15.877 14.773 16.924 14.459 18.274 14.459L18.736 14.459L18.736 11.459L18.064 11.459C16.974 11.459 15.897 11.085 14.833 10.338C13.769 9.591 13.044 8.528 12.658 7.149L12.5 6.5L15.5 6.5L15.659 7.426C15.877 8.653 16.38 9.576 17.169 10.194C17.958 10.812 19.096 11.121 20.582 11.121L21 11.121L21 21L14.017 21ZM5.01699 21L5.01699 18C5.01699 16.896 5.389 16.03 6.13299 15.401C6.87699 14.773 7.92399 14.459 9.27399 14.459L9.73599 14.459L9.73599 11.459L9.06399 11.459C7.97399 11.459 6.89699 11.085 5.83299 10.338C4.76899 9.591 4.04399 8.528 3.65799 7.149L3.49999 6.5L6.49999 6.5L6.65899 7.426C6.87699 8.653 7.37999 9.576 8.16899 10.194C8.95799 10.812 10.096 11.121 11.582 11.121L12 11.121L12 21L5.01699 21Z" /></svg>
                <p class="text-gray-700 italic mb-6 relative z-10">"{item.review}"</p>
                <div class="flex items-center gap-4">
                  <img src={['https://img.seedance22.com/seedance/avatar1.webp','https://img.seedance22.com/seedance/avatar2.webp','https://img.seedance22.com/seedance/avatar3.webp'][i % 3]} alt={item.author} class="w-10 h-10 rounded-full object-cover" loading="lazy" />
                  <div>
                    <div class="font-bold text-gray-900">{item.author}</div>
                    <div class="text-sm text-gray-500">{item.role}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-32 bg-white max-w-4xl mx-auto px-6" itemscope itemtype="https://schema.org/FAQPage">
        <h2 class="text-4xl font-black text-center mb-16">{t.faq.title}</h2>
        <div class="space-y-4">
          {t.faq.items.map((item: any) => (
            <details class="group bg-gray-50 rounded-2xl border border-gray-100 overflow-hidden" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-lg text-gray-900 hover:bg-gray-100 transition-colors select-none">
                <span itemprop="name">{item.q}</span>
                <span class="transition-transform duration-300 group-open:rotate-180 text-yellow-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <div class="text-gray-600 px-6 pb-6 pt-0 leading-relaxed animate-fade-in" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <div itemprop="text">{item.a}</div>
              </div>
            </details>
          ))}
        </div>
      </section>

    </main>
    <Footer lang={lang} t={t} />
  </body>
</html>
