---
import { getCollection } from 'astro:content';
import { languages } from '../../../i18n/locales';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SEOHead from '../../../components/SEOHead.astro';
import PersistLang from '../../../components/PersistLang.astro';
import { loadTranslations } from '../../../i18n/loadTranslations';
import GuideIndexLayout from '../../../components/guide/GuideIndexLayout.astro';

export async function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

function getPostDate(data: { pubDate?: Date; date?: Date }) {
  return data.pubDate ?? data.date ?? new Date(0);
}

const allGuides = await getCollection('guide');
const posts = allGuides.filter((entry) => entry.id.startsWith(`${lang}/`));
posts.sort((a, b) => getPostDate(b.data).valueOf() - getPostDate(a.data).valueOf());

const postsCards = posts.map((entry) => {
  const slugParts = entry.id.split('/').slice(1);
  const slug = slugParts.join('/').replace(/\.md$/, '');
  const rawDate = getPostDate(entry.data);
  const formattedDate = new Date(rawDate).toLocaleDateString(lang, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
  return {
    slug,
    title: entry.data.title,
    description: entry.data.description,
    formattedDate,
  };
});

const t = await loadTranslations(lang);
const guidePageTitle = t.guide?.page_title ?? `${t.nav?.guide} - Seedance`;
const guidePageDescription = t.guide?.description ?? t.seo?.description;
const guidePageKeywords = t.guide?.keywords ?? t.seo?.keywords;

const guideBase = lang === 'en' ? '/guide/' : `/${lang}/guide/`;
const appUrl = 'https://app.seedance22.com/generate/video-tools/seedance2.0';
---

<html lang={lang} dir={['ar', 'fa'].includes(lang) ? 'rtl' : 'ltr'} data-lang={lang}>
  <head>
    <SEOHead
      title={guidePageTitle}
      description={guidePageDescription}
      keywords={guidePageKeywords}
      lang={lang}
      image="https://img.seedance22.com/seedance/seedance-2-cover.webp"
    />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased flex flex-col min-h-screen">
    <PersistLang lang={lang} />
    <Header lang={lang} t={t} />

    <main class="flex-grow">
      <GuideIndexLayout lang={lang} t={t} guideBase={guideBase} posts={postsCards} appUrl={appUrl} />
    </main>

    <Footer lang={lang} t={t} />
  </body>
</html>
