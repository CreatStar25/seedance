---
import { getCollection } from 'astro:content';
import { languages } from '../../../i18n/locales'; // 注意路径层级
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SEOHead from '../../../components/SEOHead.astro';
import PersistLang from '../../../components/PersistLang.astro';
import { loadTranslations } from '../../../i18n/loadTranslations';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';

// 1. 生成静态路径 (为每种语言生成一个列表页)
export async function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== 'en')
    .map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;

// 2. 获取当前语言的博客文章（严格按语言前缀过滤）
const allPosts = await getCollection('blog');
const posts = allPosts.filter((post) => post.id.startsWith(`${lang}/`));

// 安全获取日期（兼容 pubDate 与 date 两种字段）
function getPostDate(data: { pubDate?: Date; date?: Date }) {
  return data.pubDate ?? data.date ?? new Date(0);
}

// 按日期倒序排列
posts.sort((a, b) => getPostDate(b.data).valueOf() - getPostDate(a.data).valueOf());

const t = await loadTranslations(lang);

// 使用独立配置的博客SEO文案
const blogPageTitle = t.blog?.page_title ?? `${t.nav.blog} - Seedance`;
const blogPageDescription = t.blog?.description ?? t.seo.description;
const blogPageKeywords = t.blog?.keywords ?? t.seo?.keywords;
const blogHeading = t.blog?.page_title ?? t.nav.blog;

// 格式化日期的辅助函数
function formatDate(date: Date) {
  return new Date(date).toLocaleDateString(lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<html lang={lang} dir={['ar','fa'].includes(lang) ? 'rtl' : 'ltr'} data-lang={lang}>
  <head>
    <SEOHead 
      title={blogPageTitle}
      description={blogPageDescription}
      keywords={blogPageKeywords}
      lang={lang} 
      image="https://img.seedance22.com/seedance/seedance-2-cover.webp"
    />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased flex flex-col min-h-screen">
    <PersistLang lang={lang} />
    <Header lang={lang} t={t} />

    <main class="flex-grow py-20 bg-gray-50">
      <div class="max-w-5xl mx-auto px-6">
        <h1 class="text-4xl md:text-5xl font-black mb-12 text-center">{blogHeading}</h1>

        <div class="grid gap-10 md:grid-cols-2">
          {posts.map((post) => {
            const slugParts = post.id.split('/').slice(1);
            const cleanSlug = slugParts.join('/').replace(/\.md$/, '');
            const coverImage = post.data.image ?? post.data.heroImage;
            return (
              <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 group">
                <a href={lang === 'en' ? `/blog/${cleanSlug}/` : `/${lang}/blog/${cleanSlug}/`}>
                  {coverImage && (
                    <div class="aspect-video overflow-hidden">
                      <ResponsiveImage
                        src={coverImage} 
                        sizes="(min-width: 768px) 448px, calc(100vw - 3rem)"
                        alt={post.data.title} 
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  )}
                  <div class="p-8">
                    <div class="text-sm text-yellow-600 font-bold mb-3">
                      {formatDate(getPostDate(post.data))}
                    </div>
                    <h2 class="text-2xl font-bold mb-3 group-hover:text-yellow-600 transition-colors">
                      {post.data.title}
                    </h2>
                    <p class="text-gray-600 line-clamp-3 leading-relaxed">
                      {post.data.description}
                    </p>
                    <div class="mt-6 flex items-center text-sm font-bold text-black group-hover:underline">
                      {t.blog?.read}
                    </div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
        
        {posts.length === 0 && (
          <div class="text-center text-gray-500 py-20">
            <p class="text-xl">{t.blog?.no_posts}</p>
          </div>
        )}
      </div>
    </main>

    <Footer lang={lang} t={t} />
  </body>
</html>
