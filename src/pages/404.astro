<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Page not found - Seedance</title>
    <meta name="description" content="The requested Seedance page could not be found." />
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #111827; background: #fffaf0; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; }
      main { width: min(42rem, calc(100% - 3rem)); text-align: center; }
      p:first-child { color: #d97706; font-weight: 800; letter-spacing: .12em; }
      h1 { margin: .5rem 0 1rem; font-size: clamp(2.25rem, 7vw, 4.5rem); line-height: 1; }
      p { color: #4b5563; line-height: 1.7; }
      a { display: inline-block; margin-top: 1.25rem; padding: .8rem 1.25rem; border-radius: .75rem; background: #111827; color: white; font-weight: 700; text-decoration: none; }
      a:focus-visible { outline: 3px solid #f59e0b; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <p>404</p>
      <h1>Page not found</h1>
      <p>The address may be incorrect, or the page may have moved.</p>
      <a href="/">Return to Seedance</a>
    </main>
  </body>
</html>
